  {
   "cell_type": "markdown",
   "id": "8bf6c515",
   "metadata": {},
   "source": [
    "- *.ravel()*: Also converts to 1D."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "e738237c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[1 2 3 4]\n"
     ]
    }
   ],
   "source": [
    "arr = np.array([\n",
    "    [1, 2],\n",
    "    [3, 4]\n",
    "])\n",
    "\n",
    "print(arr.ravel())"
   ]
  },
  {
